
"workbench.colorCustomizations": {
    // Fundo principal do editor onde o código está
    "editor.background": "#1a1a1a", 

    // Fundo da barra lateral (Explorer, SCM, Extensions)
    "sideBar.background": "#222222", 

    // Fundo da barra de atividades (ícones extremos à esquerda)
    "activityBar.background": "#222222", 

    // Fundo da barra de status (rodape)
    "statusBar.background": "#2d2d2d", 

    // Fundo da barra de título (topo da janela)
    "titleBar.activeBackground": "#2d2d2d", 
    "titleBar.inactiveBackground": "#2d2d2d", 

    // Fundo da aba ativa (onde o nome do arquivo aparece)
    "tab.activeBackground": "#1e1e1e", 

    // Fundo de outras abas inativas
    "tab.inactiveBackground": "#282c34", 

    // Fundo dos cabeçalhos de grupo do editor (acima das abas, se houver múltiplos grupos)
    "editorGroupHeader.tabsBackground": "#222222"
  }