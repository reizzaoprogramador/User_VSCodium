    },
    {
      "languageId": "latex",
      "enabled": false
    },
    {
      "languageId": "php",
      "enabled": false
    },
    {
      "languageId": "pug",
      "enabled": false
    },
    {
      "languageId": "python",
      "enabled": false
    },
    {
      "languageId": "restructuredtext",
      "enabled": false
    },
    {
      "languageId": "rust",
      "enabled": false
    },
    {
      "languageId": "scala",
      "enabled": false
    },
    {
      "languageId": "scss",
      "enabled": false
    }
  ], // Configurações de idioma do CSpell. >> para enviar novas palavras permitidas ao dicionario custom ~/.config/VSCodium/User/dictionaries/my_custom_words.txt
  "cSpell.dictionaryDefinitions": [
    {
      "name": "my-personal-words",
      "path": "/home/rzj/.config/VSCodium/User/dictionaries/my_custom_words.txt",
      "addWords": true
    }
  ], // Definição de dicionários customizados.
  "cSpell.customDictionaries": ["my-personal-words"], // Ativa o uso de dicionários customizados.
  "cSpell.ignoreHeader": false, // Não ignora cabeçalhos de arquivos.
  "cSpell.ignoreUrls": true, // Ignora URLs.
  "cSpell.ignoreHtmlComments": true, // Ignora comentários HTML.
