{
  // Configurações Runtime: KOTLIN --------------------------------------------------------------------------------------------------
  // CONFIGS DO RUNTIME : KOTLIN
  "kotlin.language-server.enabled": true,
  "kotlin.language-server.start-time-limit": 30000,
  "java.home": "/home/rzj/.sdkman/candidates/java/21.0.2-tem",
  // -- @sets: extensao IA WINDSURF -------------------
  "codeium.enableCodeLens": false, // mostrar codeium na barra de  acima das funcoes.
  "editor.quickSuggestions": {
    "other": true, // Habilita sugestões de autocompletar para todas as situações, exceto comentários e strings.
    "comments": false, // Desativa sugestões de autocompletar para comentários.
    "strings": false // Desativa sugestões de autocompletar para strings.
  },
  "editor.suggest.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false, // sugestão de autocompletar para casos especificos listados abaixo:.
  // "[javascript]": {
  //   "editor.quickSuggestions": {
  //     "other": false
  //   }
  // },
  // Configurações do Editor e Workspace (Global) ------------------------------------------------------------------------
  "workbench.editor.limit.enabled": false, // para nao ficar fechando buffer sem uso.
  "workbench.editor.enablePreview": false, // false: nao substitui arquivo ao abrir , abre outro buffer
  "editor.tabSize": 2, // Define o tamanho da tabulação para 2 espaços - space identatations.
  "editor.insertSpaces": true, // tem que habilitar espaços - para funcionar o tabsize
  "editor.formatOnSave": true, // Formata o arquivo ao salvar (configuração global).
  "editor.rulers": [120], // Define a linha visual na coluna 120.
  "editor.fontSize": 14, // Define o tamanho da fonte.
  "editor.lineHeight": 1.8, // Define a altura da linha.
  "editor.acceptSuggestionOnCommitCharacter": true, // Aceita sugestões com caracteres de commit.
  "editor.fontFamily": "JetBrains Mono", // Define a fonte padrão do editor.
  "editor.fontLigatures": true, // Ativa ligaduras de fonte.
  "editor.parameterHints.enabled": false, // Desabilita dicas de parâmetros.
  "editor.renderLineHighlight": "gutter", // Destaca a linha atual apenas na margem.
  "editor.hideCursorInOverviewRuler": true, // Oculta o cursor na régua de visão geral.
  "editor.scrollbar.vertical": "visible", // Mostra a barra de rolagem vertical.
  "editor.scrollbar.horizontal": "hidden", // Esconde a barra de rolagem horizontal.
  "editor.stickyScroll.enabled": false, // Desabilita a rolagem fixa.
  "workbench.tree.enableStickyScroll": false, // Desabilita a rolagem fixa na árvore.
  "workbench.colorTheme": "Dracula Theme", // Define o tema de cor padrão.
  "workbench.preferredLightColorTheme": "Dracula Theme", // Tema padrão para modo claro.
  "workbench.sideBar.location": "right", // Move a posicao barra lateral sidebar. opcoes: [right = direita, left = esquerda]
  "workbench.panel.defaultLocation": "bottom", // Define a localização padrão do painel.
  "workbench.editor.labelFormat": "short", // Formato curto para abas do editor.
  "workbench.commandCenter": false, // Oculta o centro de comandos.
  "workbench.startupEditor": "none", // Inicia o VSCodium sem editor aberto.
  "files.autoSave": "afterDelay", // Salva arquivos automaticamente.
  "files.enableTrash": true, // Habilita a lixeira para exclusão de arquivos.
  "files.associations": {
    "*.json": "jsonc",
    "*.css": "css",
    ".env.*": "dotenv",
    ".dev.vars": "dotenv",
    ".prettierrc": "jsonc"
  }, // Associações de arquivos.
  "explorer.confirmDelete": true, // Confirma a exclusão de arquivos.
  "explorer.confirmDragAndDrop": true, // Confirma arrastar e soltar.
  "explorer.compactFolders": false, // Desabilita pastas compactas.
  "explorer.sortOrder": "foldersNestsFiles", // Ordem de classificação do explorador.
  "explorer.fileNesting.enabled": true, // Habilita o aninhamento de arquivos.
  "explorer.fileNesting.patterns": {
    "package.json": ".eslint*, prettier*, tsconfig*, vite*, pnpm-*, bun.lockb, nest*, package-lock*",
    "tailwind.config.*": "tailwind.config*, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*"
  }, // Padrões de aninhamento de arquivos.
  "terminal.integrated.fontSize": 14, // Define o tamanho da fonte do terminal.
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font", // Fonte do terminal.
  "terminal.integrated.gpuAcceleration": "on", // Ativa aceleração GPU no terminal.
  "terminal.integrated.showExitAlert": false, // Desabilita alerta de saída do terminal.
  "git.autofetch": true, // Ativa o auto-fetch do Git.
  "git.confirmSync": false, // Desabilita confirmação de sincronização.
  "window.restoreWindows": "all", // Restaura todas as janelas ao reabrir.
  "window.closeWhenEmpty": false, // Mantém a janela aberta quando vazia.
  "window.commandCenter": false, // Oculta o centro de comandos.
  "redhat.telemetry.enabled": false, // Desabilita a telemetria Red Hat.
  "markdown-preview-enhanced.previewTheme": "github-dark.css", // Tema de pré-visualização do Markdown.
  "markdown-preview-enhanced.enableCodeBlockToolbar": true, // Habilita barra de ferramentas em blocos de código.
  // Configurações por Linguagem -----------------------------------------------------------------------------------------
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true,
    "javascript.preferences.quoteStyle": "single",
    "javascript.validate.enable": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "javascript.suggest.autoImports": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
    "editor.formatOnSave": true
  },
  "[prisma]": {
    "editor.formatOnSave": true
  },
  // Configurações de Extensões ------------------------------------------------------------------------------------------
  "prettier.printWidth": 120, // Largura máxima da linha do Prettier.
  "prettier.tabWidth": 2, // Tabulação do Prettier com 2 espaços.
  "prettier.useTabs": false, // Usa espaços em vez de tabulações.
  "prettier.singleQuote": true, // Usa aspas simples.
  "prettier.semi": false, // Remove ponto e vírgula no final da linha.
  "prettier.trailingComma": "all", // Adiciona vírgula no final de objetos e arrays.
  "prettier.bracketSpacing": true, // Espaços entre chaves de objetos.
  "prettier.arrowParens": "always", // Sempre usa parênteses em arrow functions.
  "rest-client.environmentVariables": {
    "Local Env": {
      "host": "http://localhost:8000"
    }
  }, // Variáveis de ambiente para a extensão Rest Client.
  "console-ninja.featureSet": "Community", // Configuração do Console Ninja.
  "console-ninja.toolsToEnableSupportAutomaticallyFor": {
    "live-server-extension": true,
    "live-preview-extension": true
  }, // Habilita suporte automático para ferramentas.
  "cSpell.enabled": true, // Habilita o corretor ortográfico.
  "cSpell.language": "en,en-GB,pt", // Idiomas de verificação.
  "cSpell.camelCase": true,
  "cSpell.snakeCase": true,
  "cSpell.pascalCase": true,
  "cSpell.kebabCase": true, // Permite a verificação em diferentes estilos de nomes.
  "cSpell.ignoreWords": ["camelCase", "snake_case", "exthayna", "Codeium", "Windsurf"], // Palavras a serem ignoradas.
  "cSpell.ignoreRegExpList": ["/[0-9a-fA-F]{7,}/", "/[A-Z][0-9]+/"], // Padrões RegEx a serem ignorados.
  "cSpell.languageSettings": [
    {
