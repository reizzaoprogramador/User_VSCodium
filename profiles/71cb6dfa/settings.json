{
  // ====================================================================================================================
  // GOOGLE - SETTING PROFILE -- Configurações Runtime & Ferramental por Linguagem
  // ====================================================================================================================
  // -- @sets: EDITOR : CONTROLAR LIBS EXTERNAS -------------------
  "editor.inlineSuggest.enabled": false,
  // ====================================================================================================================
  // CONFIGURAÇÃO VIM (VSCodeVim - vscodevim.vim v1.32.4) 
  // ====================================================================================================================
  "vim.enableNeovim": false,
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  // cursor configs
  "vim.cursorStylePerMode": {
    "normal": "block",
    "insert": "line",
    "replace": "underline",
    "visual": "block"
  },
  // --- Estilização do Status Bar via Modo Vim ---
  "vim.statusBarColorControl": true,
  "vim.statusBarColors": {
    "normal": "#bd93f9",
    "insert": "#50fa7b",
    "visual": "#ff79c6",
    "replace": "#f1fa8c",
    "visualline": "#ff79c6",
    "visualblock": "#ff79c6"
  },
  "apc.statusBar": {
    "view": {
      "item": false,
      "commandCenter": false
    }
  },
  // --- Mapeamentos no Modo Insert ---
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    },
    {
      "before": [
        ",",
        ","
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    // Colar da área de transferência do sistema diretamente no Modo Insert
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "p",
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    }
  ],
  // --- Mapeamentos no Modo Normal (Comandos do VSCodium) ---
  "vim.normalModeKeyBindingsNonRecursive": [
    // Salvar arquivo com 'ww' ou '<leader>ww'
    {
      "before": [
        "w",
        "w"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    {
      "before": [
        "<leader>",
        "w",
        "w"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    // Fechar buffer atual com 'bb' ou '<leader>w'
    {
      "before": [
        "b",
        "b"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "w"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    // Fechar todos os buffers/editores com 'qq'
    {
      "before": [
        "q",
        "q"
      ],
      "commands": [
        "workbench.action.closeAllEditors"
      ]
    },
    // Alternar Barra Lateral (Explorer) com '<leader>e'
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    // Alternar Terminal Integrado com '<leader>t'
    {
      "before": [
        "<leader>",
        "t"
      ],
      "commands": [
        "workbench.action.terminal.toggleTerminal"
      ]
    },
    // Selecionar tudo com '<leader>aa'
    {
      "before": [
        "<leader>",
        "a",
        "a"
      ],
      "commands": [
        "editor.action.selectAll"
      ]
    },
    // Desfazer/Refazer na memória do editor
    {
      "before": [
        "u"
      ],
      "commands": [
        "undo"
      ]
    },
    {
      "before": [
        "U"
      ],
      "commands": [
        "redo"
      ]
    },
    // --- Melhores atalhos de Clipboard / Paste de fora ---
    {
      "before": [
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "p",
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    },
    // --- Abrir Menu/Registros da Área de Transferência com <leader>rg ---
    {
      "before": [
        "<leader>",
        "r",
        "g"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    }
  ],
  // --- Mapeamentos no Modo Visual ---
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "y"
      ],
      "commands": [
        "editor.action.clipboardCopyAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "r",
        "g"
      ],
      "commands": [
        "editor.action.clipboardPasteAction"
      ]
    }
  ],
