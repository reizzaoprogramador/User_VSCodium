#!/usr/bin/env bash
# @file: vscodium_bash
# @mission: linkar configs locais ao .bashrc

export VSCODIUM_BIN="$APPIMAGES/vscodium"
alias codium="edit"
alias code="edit"

edit() {
    local TARGET="${1:-.}"

    case "$EDITOR_MASTER" in
    nvim | vim | vi)
        "$EDITOR_MASTER" "$TARGET"
        ;;
    codium | code)
        if [ -d "$TARGET" ]; then
            local WORKSPACE_FILE="$TARGET/.editor/.vscode/works.code-workspace"
            if [ -f "$WORKSPACE_FILE" ]; then
                nohup "$VSCODIUM_BIN" "$WORKSPACE_FILE" >/dev/null 2>&1 &
                return 0
            fi
        fi
        nohup "$VSCODIUM_BIN" "$TARGET" >/dev/null 2>&1 &
        ;;
    *)
        if command -v "$EDITOR_MASTER" >/dev/null 2>&1; then
            "$EDITOR_MASTER" "$TARGET"
        else
            echo "⚠️ Editor '$EDITOR_MASTER' não encontrado."
        fi
        ;;
    esac
}

ecode() {
    local WORKSPACE_FILE=".editor/.vscode/works.code-workspace"

    if [ -f "$WORKSPACE_FILE" ]; then
        nohup "$VSCODIUM_BIN" "$WORKSPACE_FILE" >/dev/null 2>&1 &
    else
        echo "⚠️ Workspace não encontrado em: $WORKSPACE_FILE"
    fi
}